@LibraryManagement.Api_HostAddress = https://localhost:7168
@Token: "JWT Token"
###
GET {{LibraryManagement.Api_HostAddress}}/api/books
Accept: application/json

###
POST {{LibraryManagement.Api_HostAddress}}/api/auth/login
Content-Type: application/json
Authorization: Bearer {{Token}}
{
  "username": "admin",
  "password": "Admin@123"
}

###
POST {{LibraryManagement.Api_HostAddress}}/api/auth/login
Content-Type: application/json
Authorization: Bearer {{Token}}
{
  "username": "librarian",
  "password": "Librarian@123"
}
###

POST {{LibraryManagement.Api_HostAddress}}/api/books
Content-Type: application/json
Authorization: Bearer {{Token}}
{
  "title": "The Love",
  "author":"Robert C. Martin",
  "isbn":"9780132350884",
  "copiesAvailable": 5
  
}

###
DELETE {{LibraryManagement.Api_HostAddress}}/api/books/3

###
GET {{LibraryManagement.Api_HostAddress}}/api/users


###
POST {{LibraryManagement.Api_HostAddress}}/api/users
Authorization: Bearer {{Token}}
Content-Type: application/json

{
  "username": "meera",
  "password": "Meera@12345",
  "role": "Librarian"
}
